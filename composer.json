{
    "name": "laravel-ux/errors",
    "description": "Polished, customizable HTTP error pages for Laravel.",
    "keywords": ["errors", "laravel", "tailwind"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0",
        "laravel/head": "^0.1"
    },
    "autoload": {
        "psr-4": {
            "LaravelUx\\Errors\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelUx\\Errors\\ErrorsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
